# TWSELA Frontend Environment Configuration

# Backend API Root URL (Spring Boot backend default: http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api

# Actuator Health endpoint
VITE_ACTUATOR_URL=http://localhost:8080/actuator

# Operating Mode: 'mock' or 'live'
# 'mock' = uses realistic simulated responses & local fixtures (for demo / offline dev)
# 'live' = directly connects to Spring Boot endpoints (for production / integration testing)
VITE_DATA_MODE=mock

# App Title & Default Tenant
VITE_APP_TITLE=Twsela Courier Platform
VITE_DEFAULT_TENANT=twsela-main
